{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draftpilot",
  "version": "2.4.1",
  "identifier": "de.nordavid.draftpilot",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Draftpilot",
        "width": 500,
        "height": 860,
        "minWidth": 440,
        "minHeight": 420,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0e0f11",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://ddragon.leagueoflegends.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0REU2OTU2Q0Q3RTE3OEQKUldTTkYzN05WbW5ldERocmtoSzZJeVZ1VC92bTRBTjlRVDR1TmFmRSs1NlhVaVVVeTZiYUMvaWcK",
      "endpoints": ["https://github.com/nordavid/draftpilot/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
